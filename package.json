{
  "name": "arthwind-suite-ts",
  "version": "1.25.2",
  "description": "An Electron application with React and TypeScript for wind turbine inspection processing and automation",
  "main": "./out/main/index.js",
  "author": "Arthwind",
  "homepage": "https://arthwind.com",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:pacman": "npm run build:linux && cd build/arch-package && makepkg -f && cp *.pkg.tar.zst ../../dist/"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@img/sharp-win32-x64": "0.35.4",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.4.3",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.12",
    "playwright": "^1.62.1",
    "sharp": "0.35.4",
    "three": "^0.185.1"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.3",
    "@img/sharp-libvips-win32-x64": "^1.3.3",
    "@img/sharp-linux-x64": "0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "happy-dom": "^17.4.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.0.7"
  },
  "onlyBuiltDependencies": [
    "@biomejs/biome",
    "electron",
    "electron-winstaller",
    "esbuild",
    "sharp"
  ]
}
